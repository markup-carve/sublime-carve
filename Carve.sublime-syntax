%YAML 1.2
---
# Carve syntax for Sublime Text 3/4.
# Authored from the maintained TextMate grammar (scope text.carve):
#   vscode-carve/syntaxes/carve.tmLanguage.json
# Scope names mirror that grammar so existing color schemes light it up.
#
# The syntax_test_carve.crv assertions run in CI (SublimeText/syntax-test-action)
# and locally without a GUI: download the headless runner for your build from
#   https://download.sublimetext.com/st_syntax_tests_build_<BUILD>_x64.tar.xz
# then copy this package into its Data/Packages/Carve and run ./syntax_tests.
name: Carve
file_extensions:
  - crv
scope: text.carve

variables:
  ws: '[ \t]'

contexts:
  # `main` is entered once, at the start of the buffer, and left on the first
  # line that is not front matter. That is what makes front matter a
  # START-OF-DOCUMENT construct here: Sublime applies a pattern to each LINE, so
  # the `\A` anchor those rules carry does NOT mean "start of buffer" - it
  # matched at the start of every line, and a `---` thematic break anywhere in
  # the file opened a YAML embed that ran to the next `---` or to the end of the
  # document. Nothing caught it because no test had a bare `---` line.
  main:
    - include: frontmatter
    - match: '(?=\S|\s)'
      set: body

  body:
    - include: comments
    - include: headings
    - include: thematic-breaks
    - include: raw-blocks
    - include: code-blocks
    - include: math-blocks
    # Before `divs`, deliberately: a bare `::: figure` opener is a composite
    # figure and not a generic container, and `divs` matches every `:::` line.
    - include: figure-groups
    - include: divs
    - include: tables
    - include: block-quotes
    - include: captions
    - include: lists
    - include: definitions
    - include: citations
    - include: crossrefs
    - include: links
    - include: images
    - include: footnotes
    - include: critic-markup
    - include: sup-sub
    - include: highlight
    - include: forced-emphasis
    - include: inline-comment
    - include: attributes
    - include: raw-inline
    - include: inline-literal
    - include: inline-code
    - include: trailing-comment
    - include: math
    - include: autolink
    - include: extension-inline
    - include: emphasis
    - include: mentions-tags
    - include: code-callouts
    - include: smart-typography

  # ----- inline-only group (reused inside tables, etc.) -----
  inline:
    - include: raw-inline
    - include: inline-literal
    - include: inline-code
    - include: math
    - include: crossrefs
    - include: autolink
    - include: extension-inline
    - include: critic-markup
    - include: citations
    - include: links
    - include: images
    - include: footnotes
    - include: sup-sub
    - include: highlight
    - include: forced-emphasis
    - include: attributes
    - include: emphasis
    - include: mentions-tags
    - include: code-callouts
    - include: smart-typography

  # ----- Frontmatter -----
  # Carve does not interpret frontmatter - the fence token declares the format
  # and the application parses it - so highlight the body with that format's
  # syntax. Bare `---` is YAML by convention; `---toml` / `---json` embed those.
  frontmatter:
    - match: '\A(---)[ \t]*(toml)[ \t]*$'
      captures:
        1: punctuation.definition.frontmatter.begin.carve
        2: entity.name.type.frontmatter.carve
      embed: scope:source.toml
      embed_scope: meta.frontmatter.carve
      escape: '^(---)\s*$'
      escape_captures:
        1: punctuation.definition.frontmatter.end.carve
    - match: '\A(---)[ \t]*(json)[ \t]*$'
      captures:
        1: punctuation.definition.frontmatter.begin.carve
        2: entity.name.type.frontmatter.carve
      embed: scope:source.json
      embed_scope: meta.frontmatter.carve
      escape: '^(---)\s*$'
      escape_captures:
        1: punctuation.definition.frontmatter.end.carve
    - match: '\A(---)[ \t]*(yaml|yml)?[ \t]*$'
      captures:
        1: punctuation.definition.frontmatter.begin.carve
        2: entity.name.type.frontmatter.carve
      embed: scope:source.yaml
      embed_scope: meta.frontmatter.carve
      escape: '^(---)\s*$'
      escape_captures:
        1: punctuation.definition.frontmatter.end.carve
    # An unknown format keeps the body as plain text.
    - match: '\A(---)[ \t]*([A-Za-z0-9_-]+)[ \t]*$'
      captures:
        1: punctuation.definition.frontmatter.begin.carve
        2: entity.name.type.frontmatter.carve
      push:
        - meta_scope: meta.frontmatter.carve
        - match: '^(---)\s*$'
          captures:
            1: punctuation.definition.frontmatter.end.carve
          pop: true
        - match: '.+'
          scope: string.unquoted.frontmatter.carve

  # ----- Comments -----
  comments:
    # A `%%%` fence line is a DELIMITER plus an INSIGNIFICANT TAIL (spec PART 9
    # section 28): only the leading run of `%` is structural, so `%%% TODO`
    # opens and `%%% end` closes. `%%%` carries no info string - a raw
    # passthrough block is a CODE fence with an `=FORMAT` info string - so
    # `%%% html` is a comment, not raw output.
    #
    # The closer matches the opener width EXACTLY via a backreference, which is
    # what lets a longer fence nest a shorter one: inside a `%%%%` block a
    # `%%%` line is content. `\1` in the pop pattern refers to the capture from
    # the push pattern, so the width travels with the context.
    - match: '^\s*(%{3,})[^\n]*$'
      captures:
        1: punctuation.definition.comment.carve
      push:
        - meta_scope: comment.block.carve
        - match: '^\s*(\1)(?!%)[^\n]*$'
          captures:
            1: punctuation.definition.comment.carve
          pop: true
    - match: '^\s*%%(?!%).*$'
      scope: comment.line.percent.carve

  # A DELIMITED INLINE COMMENT, `{% ... %}` (PART 9 section 21a,
  # markup-carve/carve#1239). It hides its payload the way `%%` hides the rest
  # of a line, so it is scoped WHOLE rather than letting the emphasis and
  # attribute rules reach inside: `{% *not bold* %}` must not render a bold
  # run. Listed BEFORE `attributes`, which matches `{% ... %}` at the same
  # column and would otherwise win the tie by being listed first - that is what
  # CI caught. A `{%` inside a code span still stays code without help from the
  # ordering: `inline-code` starts at the backtick, one column earlier, and
  # Sublime takes the earliest match before it considers the listing order.
  inline-comment:
    - match: '\{%[^\n]*?%\}'
      scope: comment.block.inline.carve

  trailing-comment:
    - match: '(?<=[ \t])%%.*$'
      scope: comment.line.percent.carve

  trailing-comment-cell:
    - match: '(?<=[ \t])%%[^|]*'
      scope: comment.line.percent.carve

  # ----- Headings -----
  # ----- Thematic breaks -----
  # Three spellings, all equivalent (PART 9): `---`, `***`, `___`. Indentation
  # is allowed because a break can open inside a container, where the content
  # column is not zero and Carve has no indented code block to disambiguate
  # against. Frontmatter is matched earlier and only at the very start of the
  # buffer, so a leading `---` there is not stolen by this rule.
  thematic-breaks:
    - match: '^[ \t]*(-{3,}|\*{3,}|_{3,})[ \t]*$'
      scope: meta.separator.thematic-break.carve
      captures:
        1: punctuation.definition.thematic-break.carve

  headings:
    - match: '^(#{1,6})( +)(?![ \t]*$)(.+)$'
      scope: markup.heading.carve
      captures:
        1: punctuation.definition.heading.carve
        3: entity.name.section.carve

  # ----- Fenced code blocks (with optional language + #201 "header"/[label]) -----
  # Fenced code. A block whose info string names a language Sublime ships gets
  # that language embedded, so the code inside is really highlighted; anything
  # else (mermaid, chart, an unknown tag, no tag at all) falls through to the
  # last rule and stays plain raw text.
  code-blocks:
    - match: '^(`{3,}|~{3,})[ \t]*(python|py)\b(.*)$'
      captures:
        1: punctuation.definition.raw.begin.carve
        2: entity.name.type.language.carve
        3: meta.code-fence.header.carve
      embed: scope:source.python
      embed_scope: markup.raw.block.fenced.code.carve
      escape: '^(`{3,}|~{3,})\s*$'
      escape_captures:
        1: punctuation.definition.raw.end.carve
    - match: '^(`{3,}|~{3,})[ \t]*(javascript|js|node)\b(.*)$'
      captures:
        1: punctuation.definition.raw.begin.carve
        2: entity.name.type.language.carve
        3: meta.code-fence.header.carve
