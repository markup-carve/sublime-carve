%YAML 1.2
---
name: TSV (Carve)
hidden: true
scope: text.tsv.carve

contexts:
  main:
    - match: '\n'
      set: header
  header:
    - meta_scope: meta.record.header.tsv
    - match: '\n'
      set: records
    - include: header-fields
  records:
    - include: fields
  header-fields:
    - include: separator
    - match: '(?:^ *|(?<=\t))(")'
      captures:
        1: punctuation.definition.string.begin.tsv
      push: header-quoted
    - include: header-text
  header-text:
    - match: '[^\t\r\n]+'
      scope: string.unquoted.tsv markup.heading.tsv
  fields:
    - include: separator
    - match: '(?:^ *|(?<=\t))(")'
      captures:
        1: punctuation.definition.string.begin.tsv
      push: quoted
    # A stray or trailing quote is field text: a malformed table fence just stays code.
    - include: text
  text:
    - match: '[^\t\r\n]+'
      scope: string.unquoted.tsv
  separator:
    - match: '\t'
      scope: keyword.operator.separator.tsv
  quoted:
    - meta_scope: string.quoted.double.tsv
    - include: escape
    - match: '"(?!")'
      scope: punctuation.definition.string.end.tsv
      set: after-quote
  header-quoted:
    - meta_scope: string.quoted.double.tsv markup.heading.tsv
    - include: escape
    - match: '"(?!")'
      scope: punctuation.definition.string.end.tsv
      set: header-after-quote
  escape:
    - match: '""'
      scope: constant.character.escape.tsv
  after-quote:
    - include: text
    - match: '(?=[\t\n]|$)'
      pop: true
  header-after-quote:
    - include: header-text
    - match: '(?=[\t\n]|$)'
      pop: true
