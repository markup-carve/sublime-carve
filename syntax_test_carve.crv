# A ROMAN RUN IS CASE-CONSISTENT (markup-carve/carve-grammars#118). One
# `[ivxlcdmIVXLCDM]` class matched any mixture, so `Vim.` and `Mix.` - the shape
# of a word starting a sentence - coloured as markers. `mix.` IS a marker (1009),
# so the fix is the case split, not a rule against multi-letter runs.
iv. a lower-case roman marker
# <- punctuation.definition.list.begin.carve
IV. an upper-case roman marker
# <- punctuation.definition.list.begin.carve
ivx. a longer lower-case run
# <- punctuation.definition.list.begin.carve
IVX. a longer upper-case run
# <- punctuation.definition.list.begin.carve
mix. a word made only of roman letters is still a marker
# <- punctuation.definition.list.begin.carve
Vim. mixed case is prose
# <- -punctuation.definition.list.begin.carve
Mix. mixed case is prose
# <- -punctuation.definition.list.begin.carve
Ix. two letters, mixed case, prose
# <- -punctuation.definition.list.begin.carve
Note. an ordinary sentence start is prose
# <- -punctuation.definition.list.begin.carve

# MARKER REQUIRES CONTENT PAST THE ATTRIBUTE BLOCK
# (markup-carve/carve-grammars#85). The guard was `(?= |\{)`, so an empty block
# with nothing after it still coloured as a marker.
1.{#x} an attributed item
# <- punctuation.definition.list.begin.carve
1.{title="a}b"} a `}` inside a quoted value does not end the block
# <- punctuation.definition.list.begin.carve
1.{#x} {*bold*} content may itself be a brace span
# <- punctuation.definition.list.begin.carve
1.{#x}
# <- -punctuation.definition.list.begin.carve
.{#x}
# <- -punctuation.definition.list.begin.carve
1.{#x}{.y} two glued blocks are prose even with content
# <- -punctuation.definition.list.begin.carve

# A BULLET MAY BE GLUED TO AN ATTRIBUTE BLOCK (#22). The required space comes
# after the block, so the old ` +` guard left the marker uncoloured on a line
# that IS a list item. Content is still required past the block.
-{#x} an attributed bullet
# <- punctuation.definition.list.begin.carve
#^^^^ meta.attributes.carve
*{.c} an attributed star bullet
# <- punctuation.definition.list.begin.carve
-{title="a}b"} a `}` inside a quoted value does not end the block
# <- punctuation.definition.list.begin.carve
-{#x}
# <- -punctuation.definition.list.begin.carve
-{#x}{.y} two glued blocks are prose even with content
# <- -punctuation.definition.list.begin.carve
# KNOWN LIMITATION, shared with every other Carve TextMate grammar: the task
# marker after a glued block is not scoped, because the block is looked ahead at
# rather than consumed, so the task group never reaches past it. The bullet
# itself IS a marker, which is what this pins.
-{.c} [x] done
# <- punctuation.definition.list.begin.carve

# ALL SEVEN TASK STATES (grammar.ebnf `task_state`), not just `[ xX]` (#23).
# Only `x`/`X` render CHECKED; the other five are still task markers.
- [x] checked
#  ^^^ constant.language.task-list.carve
- [X] checked, upper case
#  ^^^ constant.language.task-list.carve
- [ ] unchecked
#  ^^^ constant.language.task-list.carve
- [-] dropped
#  ^^^ constant.language.task-list.carve
- [_] paused
#  ^^^ constant.language.task-list.carve
- [>] deferred
#  ^^^ constant.language.task-list.carve
- [?] unsure
#  ^^^ constant.language.task-list.carve

# An empty task item is a plain bullet holding the literal `[ ]` - the marker is
# a marker, but no checkbox forms. carve-js renders `<li>[ ]</li>`.
- [ ] 
# <- punctuation.definition.list.begin.carve
#  ^^^ -constant.language.task-list.carve

# An abbreviation term is `(letter | digit)+`, and `letter` is enumerated ASCII.
# So the term is case-blind, may lead with a digit, and may be a digit alone.
# Every abbreviation sample in the shared corpus uses an uppercase multi-letter
# term, which is the one shape every misreading of this rule still agrees on -
# so these are the shapes that separate them (carve#791).

*[HTML]: HyperText Markup Language
# ^^^^ entity.name.abbreviation.carve
*[dl]: definition list
# ^^ entity.name.abbreviation.carve
*[Wm]: watt metre
# ^^ entity.name.abbreviation.carve
*[3D]: three dimensional
# ^^ entity.name.abbreviation.carve
*[9]: nine
# ^ entity.name.abbreviation.carve

# Outside that alphabet the line is not a definition at all - it stays ordinary
# paragraph text. That direction matters: an abbreviation has no marker at the
# use site, so calling this a definition would tell the reader the line vanishes
# from the rendered document, and it does not.

*[e.g.]: for example
# ^^^^ -entity.name.abbreviation.carve
*[HTTP API]: an interface
# ^^^^^^^^ -entity.name.abbreviation.carve
