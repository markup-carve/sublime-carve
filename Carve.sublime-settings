{
	// Path to the `carve` executable used by the format and import commands.
	// Leave as "carve" to use whatever is on PATH, or give a command list such
	// as ["node", "/path/to/@markup-carve/carve/dist/cli.js"].
	"carve_binary": "carve",

	// Run `carve fmt` over the buffer every time a .crv file is saved.
	// Off by default: formatting on save should be an explicit choice.
	"carve_format_on_save": false,

	// The include root the Lint build passes to `carve lint --include-root`,
	// so lint follows {{ path }} includes inside it and reports findings in
	// the included files with their include chain.
	//   "project"   the deepest project folder that holds the file, else the
	//               file's own directory
	//   "file_dir"  the file's own directory
	//   false       no include root: includes are not followed
	//   "/abs/dir"  an explicit absolute directory
	// A carve CLI older than carve-js 0.1.13 or carve-rs 0.1.11 has no
	// `lint --include-root`; the build then lints without it and says so.
	"carve_lint_include_root": "project"
}
