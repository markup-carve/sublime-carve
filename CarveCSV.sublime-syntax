%YAML 1.2
---
name: CSV (Carve)
hidden: true
scope: text.csv.carve

contexts:
  main:
    - match: '\n'
      set: header
  header:
    - meta_scope: meta.record.header.csv
    - match: '\n'
      set: records
    - include: header-fields
  records:
    - include: fields
  header-fields:
    - include: separator
    - match: '(?:^[ \t]*|(?<=,))(")'
      captures:
        1: punctuation.definition.string.begin.csv
      push: header-quoted
    - include: header-text
  header-text:
    - match: '[^,\r\n]+'
      scope: string.unquoted.csv markup.heading.csv
  fields:
    - include: separator
    - match: '(?:^[ \t]*|(?<=,))(")'
      captures:
        1: punctuation.definition.string.begin.csv
      push: quoted
    # A stray or trailing quote is field text: a malformed table fence just stays code.
    - include: text
  text:
    - match: '[^,\r\n]+'
      scope: string.unquoted.csv
  separator:
    - match: ','
      scope: punctuation.separator.delimiter.csv
  quoted:
    - meta_scope: string.quoted.double.csv
    - include: escape
    - match: '"(?!")'
      scope: punctuation.definition.string.end.csv
      set: after-quote
  header-quoted:
    - meta_scope: string.quoted.double.csv markup.heading.csv
    - include: escape
    - match: '"(?!")'
      scope: punctuation.definition.string.end.csv
      set: header-after-quote
  escape:
    - match: '""'
      scope: constant.character.escape.csv
  after-quote:
    - include: text
    - match: '(?=[,\n]|$)'
      pop: true
  header-after-quote:
    - include: header-text
    - match: '(?=[,\n]|$)'
      pop: true
